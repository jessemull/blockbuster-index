    "dotenv": "^16.4.7",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.1.7",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.3.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
